{
  "family": "order-service",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::402338187344:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "db",
      "image": "postgres:12",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 256,
      "environment": [
        { "name": "POSTGRES_DB", "value": "order_db" },
        { "name": "POSTGRES_USER", "value": "postgres" },
        { "name": "POSTGRES_PASSWORD", "value": "postgres" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U postgres || exit 1"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/order-service",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "db",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "app",
      "image": "402338187344.dkr.ecr.ap-south-1.amazonaws.com/order-service:latest",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 256,
      "dependsOn": [
        {
          "containerName": "db",
          "condition": "HEALTHY"
        }
      ],
      "portMappings": [
        {
          "containerPort": 8002,
          "hostPort": 8002,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "POSTGRES_HOST", "value": "db" },
        { "name": "POSTGRES_PORT", "value": "5432" },
        { "name": "POSTGRES_USER", "value": "postgres" },
        { "name": "POSTGRES_PASSWORD", "value": "postgres" },
        { "name": "POSTGRES_DB", "value": "order_db" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/order-service",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "app",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
